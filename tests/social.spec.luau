local Config = require("../src/shared/GameConfig")
local Profile = require("../src/shared/Progression")
local Party = require("../src/shared/PartyRules")
local Travel = require("../src/shared/TravelRules")
local WorldMap = require("../src/shared/WorldMap")
local n = 0
local function eq(actual, expected, message)
	n += 1
	assert(actual == expected, message .. ": expected " .. tostring(expected) .. ", got " .. tostring(actual))
end
local s = Party.new(Config)
eq(Party.accept(s, 2, 1, 0, Config).status, "invite", "consent required")
eq(Party.invite(s, 1, 1, 0, Config).status, "invalid", "self invite rejected")
eq(Party.invite(s, 1, 2, 0, Config).status, "invited", "invite created")
eq(s.membership[2], nil, "invite does not autojoin")
eq(s.membership[1], nil, "pending invitation does not create party")
eq(Party.invite(s, 3, 2, 1, Config).status, "pending", "another leader cannot overwrite pending invite")
eq(Party.accept(s, 2, 3, 1, Config).status, "invite", "cannot accept wrong leader")
eq(Party.accept(s, 2, 1, 30, Config).status, "expired", "deadline exclusive")
eq(s.membership[2], nil, "expired consent does not join")
eq(Party.invite(s, 1, 2, 31, Config).status, "invited", "fresh invitation after expiration")
eq(Party.decline(s, 2, 3).status, "invite", "decline wrong inviter no effect")
eq(Party.decline(s, 2, 1).status, "declined", "explicit decline")
eq(Party.accept(s, 2, 1, 32, Config).status, "invite", "decline cannot be replayed")
Party.invite(s, 1, 2, 32, Config)
eq(Party.accept(s, 2, 1, 33, Config).status, "joined", "accepted party")
eq(Party.leader(s, 2), 1, "leader established")
eq(#Party.members(s, 1), 2, "two members")
eq(Party.accept(s, 2, 1, 34, Config).status, "invite", "accept replay rejected")
eq(Party.invite(s, 2, 3, 34, Config).status, "leader", "only leader may invite")
for id = 3, 5 do Party.invite(s, 1, id, 34, Config) end
Party.accept(s, 3, 1, 35, Config)
Party.accept(s, 4, 1, 35, Config)
eq(Party.accept(s, 5, 1, 35, Config).status, "full", "parallel pending invites respect capacity")
eq(#Party.members(s, 1), 4, "hard capacity four")
eq(s.membership[5], nil, "overflow target remains solo")
eq(Party.invite(s, 1, 6, 36, Config).status, "full", "full group cannot invite")
eq(Party.kick(s, 2, 3).status, "leader", "member cannot kick")
eq(Party.kick(s, 1, 1).status, "leader", "leader cannot kick self")
eq(Party.kick(s, 1, 4).status, "kicked", "leader kick")
eq(s.membership[4], nil, "kick clears membership")
eq(Party.accept(s, 5, 1, 36, Config).status, "joined", "pending invite works when slot opens")
local snapshot = Party.members(s, 1)
snapshot[1] = 99
eq(Party.leader(s, 1), 1, "public member array isolated")
Party.invite(s, 4, 6, 36, Config)
Party.accept(s, 6, 4, 36, Config)
eq(Party.invite(s, 1, 6, 36, Config).status, "member", "single membership across parties")
Party.leave(s, 1)
eq(Party.leader(s, 2), 2, "leader departure transfers to next member")
eq(s.membership[1], nil, "leader departed")
Party.leave(s, 3)
Party.leave(s, 5)
eq(#Party.members(s, 2), 1, "one member can remain leader")
local oldId = s.membership[2]
Party.leave(s, 2)
eq(s.parties[oldId], nil, "last departure removes party")
Party.invite(s, 7, 8, 40, Config)
Party.leave(s, 7)
eq(s.invites[8], nil, "disconnected inviter clears pending invite")
Party.invite(s, 7, 8, 40, Config)
Party.leave(s, 8)
eq(s.invites[8], nil, "disconnected invitee clears pending invite")
eq(Party.invite(s, 7, 8, 0/0, Config).status, "invalid", "nonfinite invite clock")
eq(Party.accept(s, 8, 7, math.huge, Config).status, "invalid", "nonfinite accept clock")
eq(Party.assistEligible(true, 100, Config), true, "assist exact radius")
eq(Party.assistEligible(true, 100.01, Config), false, "assist outside radius")
eq(Party.assistEligible(false, 1, Config), false, "dead assist excluded")
eq(Party.assistEligible(true, math.huge, Config), false, "invalid assist geometry")
eq(Party.assistEligible(true, -1, Config), false, "negative assist geometry")
for _, value in {10, 30, 50, 80, 110} do
	eq(Party.rewardXP(value, false, Config), value, "attacker full XP")
	eq(Party.rewardXP(value, true, Config), math.floor(value * 0.7), "nearby assist 70 percent XP")
end
eq(Party.rewardXP(0/0, true, Config), 0, "NaN cannot grant assist XP")
local race = Party.new()
Party.invite(race, 10, 11, 1, Config)
Party.invite(race, 12, 10, 1, Config)
Party.accept(race, 10, 12, 2, Config)
eq(race.invites[11], nil, "joining invalidates outgoing solo invitation")
eq(Party.accept(race, 11, 10, 3, Config).status, "invite", "stale outgoing invitation cannot join another party")
Party.invite(race, 13, 12, 3, Config)
eq(race.invites[12], nil, "existing leader cannot be invited to a second group")
local creation = Party.new()
Party.invite(creation, 3, 1, 1, Config)
Party.invite(creation, 1, 2, 1, Config)
Party.accept(creation, 2, 1, 2, Config)
eq(creation.invites[1], nil, "creating a party clears leader's incoming invitation")

local p = Profile.newProfile()
local origin = {x = 0, y = 3, z = 0}
local function begin(id, distance, alive, trusted, combat, now)
	return Travel.begin(p, id, distance, alive, trusted, combat, now, Config, "character1", origin)
end
eq(begin("forest", 0, true, true, -math.huge, 100).status, "locked", "discovery required")
eq(begin("admin", 0, true, true, -math.huge, 100).status, "invalid", "destination whitelist")
eq(begin("village", 16.01, true, true, 0, 100).status, "source", "must be at source shrine")
eq(begin("village", 16, false, true, 0, 100).status, "dead", "alive required")
eq(begin("village", 16, true, false, 0, 100).status, "untrusted", "trusted movement required")
eq(begin("village", 16, true, true, 90.01, 100).status, "combat", "combat lock not elapsed")
eq(begin("village", 16, true, true, 90, 100).status, "started", "exact source and combat boundaries")
eq(begin("village", 0, true, true, 0/0, 100).status, "invalid", "NaN combat timestamp")
eq(begin("village", 0, true, true, 0, math.huge).status, "invalid", "infinite travel clock")
eq(begin("village", 0/0, true, true, 0, 100).status, "invalid", "NaN source distance")
eq(Travel.canStart(p, "village", 0, true, true, 0, 100, Config, "village"), "same", "same shrine travel rejected")
local result = begin("village", 0, true, true, -math.huge, 100)
local channel = result.channel
eq(result.status, "started", "never fought may travel")
eq(channel.endsAt, 103, "absolute three-second channel")
origin.x = 50
eq(channel.origin.x, 0, "channel origin copied")
local function check(now, pos, char, alive, trusted, damage)
	return Travel.check(channel, now, pos, char, alive, trusted, damage, Config)
end
local still = {x = 0, y = 3, z = 0}
eq(check(102.99, still, "character1", true, true, 99), "channeling", "not early completion")
eq(check(103, still, "character1", true, true, 99), "ready", "exact completion")
eq(check(103, {x = 3, y = 3, z = 0}, "character1", true, true, 99), "ready", "exact movement tolerance")
eq(check(103, {x = 3.01, y = 3, z = 0}, "character1", true, true, 99), "cancelled", "movement cancels")
eq(check(103, {x = 0, y = 6.1, z = 0}, "character1", true, true, 99), "cancelled", "vertical movement cancels")
eq(check(103, still, "character1", true, true, 100), "cancelled", "damage at start cancels")
eq(check(103, still, "character1", true, true, 102), "cancelled", "damage during channel cancels")
eq(check(103, still, "character2", true, true, 99), "cancelled", "respawn cancels")
eq(check(103, still, "character1", false, true, 99), "cancelled", "death cancels")
eq(check(103, still, "character1", true, false, 99), "cancelled", "untrusted movement cancels")
eq(check(99, still, "character1", true, true, 99), "cancelled", "clock rollback cancels")
eq(check(103, {x = 0/0, y = 3, z = 0}, "character1", true, true, 99), "cancelled", "NaN position cancels")
eq(check(103, still, "character1", true, true, 0/0), "cancelled", "NaN damage time cancels")
for version = 1, 3 do
	local old = Profile.sanitize({version = version, level = 5, xp = 12, gold = 77, classId = "mage", equipmentTier = 2,
		pets = {mossling = true}, equippedPet = "mossling", petPity = {thornwarden = 12}, materials = {wood = 8}, expedition = {stage = 3, progress = 2}})
	eq(old.version, 5, "schema upgrade")
	eq(old.waypoints.village, true, "old profile default village")
	eq(old.waypoints.forest, nil, "old profile must discover field destinations")
	eq(old.gold, 77, "old currency preserved")
	eq(old.classId, "mage", "old class preserved")
	eq(old.equipmentTier, 2, "old tier preserved")
	eq(old.materials.wood, 8, "old materials preserved")
	eq(old.expedition.progress, 2, "old quest progress preserved")
	eq(old.petPity.thornwarden, 12, "old boss guarantee preserved")
end
local raw = {waypoints = {village = false, forest = true, marsh = "true", admin = true}}
local clean = Profile.sanitize(raw)
eq(clean.waypoints.village, true, "village always unlocked")
eq(clean.waypoints.forest, true, "known discovery kept")
eq(clean.waypoints.marsh, nil, "discovery requires boolean")
eq(clean.waypoints.admin, nil, "unknown waypoint discarded")
raw.waypoints.forest = false
eq(clean.waypoints.forest, true, "loaded discoveries isolated")
local saved = Profile.snapshot(clean)
clean.waypoints.volcanic = true
eq(saved.waypoints.volcanic, nil, "save discoveries deep snapshot")
local a, b = Profile.newProfile(), Profile.newProfile()
a.waypoints.forest = true
eq(b.waypoints.forest, nil, "profiles discovery maps isolated")
for id, region in Config.Regions do
	eq(WorldMap.regionAt(region.X, region.Z, Config), id, "region center recognized")
	local bounds = Config.MapBounds
	eq(region.X - region.Radius > bounds.MinX and region.X + region.Radius < bounds.MaxX, true, "biome fits world width")
	eq(region.Z - region.Radius > bounds.MinZ and region.Z + region.Radius < bounds.MaxZ, true, "biome fits world depth")
	local normal = Profile.newProfile()
	normal.questStatus = "active"
	local xp = Party.rewardXP(Config.KillXP * region.EnemyLevel, true, Config)
	eq(Profile.recordRegionKill(normal, id, xp, Config), true, "region assist accepted")
	eq(normal.kills, 1, "one normal kill credit")
	eq(normal.questKills, id == "forest" and 1 or 0, "legacy quest limited to forest assists")
	eq(normal.materials[region.Material], 1, "region assist grants correct material")
	local expectedLevel, expectedXP = Profile.addXP(1, 0, xp)
	eq(normal.level, expectedLevel, "assist level up correct")
	eq(normal.xp, expectedXP, "assist XP amount exact")
end
eq(WorldMap.regionAt(0, 0, Config), "village", "safe village recognized")
eq(WorldMap.regionAt(0/0, 0, Config), nil, "invalid geometry rejected")
eq(WorldMap.regionAt(1400, 400, Config), nil, "open route outside regions")
local u, v = WorldMap.normalized(0, -700, Config)
eq(u, 0.5, "expanded map horizontal center")
eq(v, 0.5, "expanded map vertical center")
for id, waypoint in Config.Waypoints do
	local point = waypoint.Position
	eq(WorldMap.regionAt(point.x, point.z, Config), waypoint.RegionId, "shrine belongs to its biome")
	local discovered = Profile.sanitize({waypoints = {[id] = true}})
	eq(discovered.waypoints[id], true, "all known discoveries survive persistence")
end
local frontier = Profile.sanitize({version = 3, expedition = {stage = 5, progress = 0}})
eq(frontier.expedition.stage, 5, "old completed campaign unlocks frontier")
eq(frontier.expedition.progress, 0, "new frontier not prefilled")
frontier.expedition.stage, frontier.expedition.progress = 6, 7
local frontierSaved = Profile.snapshot(frontier)
eq(frontierSaved.expedition.progress, 7, "new expedition progress persists")
eq(Profile.recordRegionKill(frontier, "admin", 100, Config), false, "unknown region cannot grant normal reward")
eq(Profile.recordRegionKill(frontier, "forest", math.huge, Config), false, "infinite normal XP rejected")
print("Social and travel: " .. n .. " assertions passed")
