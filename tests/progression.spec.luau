local Progression = require("../src/shared/Progression")
local Config = require("../src/shared/GameConfig")
local assertions = 0
local function equal(actual, expected, label)
	assertions += 1
	assert(actual == expected, label .. ": expected " .. tostring(expected) .. ", got " .. tostring(actual))
end

local level, xp = Progression.addXP(1, 49, 1)
equal(level, 2, "exact level threshold")
equal(xp, 0, "threshold leaves zero XP")
level, xp = Progression.addXP(1, 0, 225)
equal(level, 4, "multiple levels from one reward")
equal(xp, 0, "multiple level remainder")
level, xp = Progression.addXP(2, 12, -50)
equal(level, 2, "negative reward preserves level")
equal(xp, 12, "negative reward preserves XP")

local profile = Progression.newProfile()
Progression.recordKill(profile, Config)
equal(profile.kills, 1, "kills outside quest counted")
equal(profile.questKills, 0, "kills before accepting do not advance quest")
equal(Progression.interact(profile, Config), "started", "accept quest")
equal(Progression.interact(profile, Config), "active", "incomplete quest cannot be delivered")
equal(profile.gold, 0, "incomplete quest gives no gold")
for _ = 1, Config.QuestTarget do Progression.recordKill(profile, Config) end
equal(profile.questStatus, "return", "target reached")
Progression.recordKill(profile, Config)
equal(profile.questKills, Config.QuestTarget, "extra kills do not overflow target")
local beforeLevel, beforeXP = profile.level, profile.xp
local expectedLevel, expectedXP = Progression.addXP(beforeLevel, beforeXP, Config.QuestXP)
equal(Progression.interact(profile, Config), "completed", "deliver quest")
equal(profile.level, expectedLevel, "delivery awards XP once")
equal(profile.xp, expectedXP, "delivery XP remainder")
equal(profile.gold, Config.QuestGold, "delivery gold")
equal(profile.hasCrystal, true, "delivery crystal")
equal(Progression.interact(profile, Config), "started", "repeat starts a new quest")
equal(profile.questKills, 0, "repeat resets target")
equal(profile.gold, Config.QuestGold, "repeat interaction cannot duplicate reward")
equal(profile.xp, expectedXP, "repeat interaction cannot duplicate XP")

local clean = Progression.sanitize({level = -7, xp = math.huge, gold = 0/0, kills = -3,
	questKills = "3", questStatus = "admin", hasCrystal = "true", ignored = 1})
equal(clean.level, 1, "negative level normalized")
equal(clean.xp, 0, "infinite XP discarded")
equal(clean.gold, 0, "NaN discarded")
equal(clean.kills, 0, "negative kills clamped")
equal(clean.questKills, 0, "wrong type discarded")
equal(clean.questStatus, "available", "unknown status discarded")
equal(clean.hasCrystal, false, "crystal requires boolean")
equal(clean.ignored, nil, "unknown persisted field discarded")
local saved = Progression.sanitize(profile)
equal(saved.gold, profile.gold, "valid saved gold retained")
equal(saved.questStatus, "active", "valid saved quest retained")
equal(saved.hasCrystal, true, "valid saved crystal retained")
equal(Progression.sanitize(nil).level, 1, "missing save initializes profile")
print("Progression: " .. assertions .. " assertions passed")
